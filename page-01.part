<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=yes">
<meta name="theme-color" content="#15130f">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="无尽战域">
<meta name="mobile-web-app-capable" content="yes">
<link rel="manifest" href="./manifest.webmanifest">
<link rel="apple-touch-icon" sizes="180x180" href="./apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="192x192" href="./icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="./icon-512.png">
<title>无尽战域：核心 Alpha 0.30</title>
<style>
:root{
  --bg:#15130f;--panel:#211d16;--panel2:#2a241a;--line:#4b402e;
  --text:#eadfca;--muted:#a99a80;--gold:#d7ad55;--good:#6cc47e;
  --bad:#df6d61;--blue:#6fa9df;--purple:#b68bd8;
}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(circle at top,#2a241a,#11100d 60%);color:var(--text);font:14px/1.45 Arial,"Microsoft YaHei",sans-serif}
button,select{font:inherit}
button{background:#3a3022;color:var(--text);border:1px solid #665437;padding:7px 10px;cursor:pointer}
button:hover{border-color:var(--gold);background:#493b28}
button:disabled{opacity:.45;cursor:not-allowed}
.shell{max-width:1240px;margin:auto;padding:10px}
.topbar{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;border:1px solid var(--line);background:#1b1812;padding:10px 13px}
h1{font-size:22px;margin:0;color:#f0c86d;letter-spacing:1px}
.subtitle{color:var(--muted);font-size:12px}
.resources{display:flex;gap:14px;flex-wrap:wrap;justify-content:flex-end}
.resources b{color:#fff}.xp-chip{min-width:128px}.xp-mini{display:inline-block;width:68px;height:6px;margin-left:5px;background:#0f0d0a;border:1px solid #403624;vertical-align:middle}.xp-mini i{display:block;height:100%;background:#6fa9df}
.layout{display:grid;grid-template-columns:330px 1fr;gap:10px;margin-top:10px}
.panel{border:1px solid var(--line);background:linear-gradient(#242016,#1b1812);box-shadow:0 4px 16px #0006}
.panel-title{padding:8px 10px;border-bottom:1px solid var(--line);color:var(--gold);font-weight:bold;background:#2b251b}
.battle{padding:10px}
.combatant{border:1px solid #554830;background:#17140f;padding:9px;margin-bottom:8px}
.name-row{display:flex;justify-content:space-between;gap:8px;align-items:center}
.big-name{font-weight:bold;font-size:16px}
.badge{padding:2px 6px;border:1px solid #68583b;font-size:11px}
.bar{height:14px;background:#0f0d0a;border:1px solid #403624;margin-top:6px;position:relative}
.fill{height:100%;transition:width .18s}
.hp{background:linear-gradient(90deg,#7b201a,#d85445)}
.mp{background:linear-gradient(90deg,#224f78,#4d99cf)}
.bar span{position:absolute;inset:0;text-align:center;font-size:10px;line-height:12px;color:#fff;text-shadow:0 1px 2px #000}
.stats-mini{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin-top:7px}
.stats-mini div{background:#262017;padding:5px;text-align:center;font-size:11px}
.log{height:310px;overflow:auto;border-top:1px solid var(--line);background:#11100d;padding:8px;font-size:12px}
.log div{margin-bottom:4px}
.log .win{color:var(--good)}.log .lose{color:var(--bad)}.log .loot{color:#e9c96d}.log .skill{color:#85b9e6}.log .sys{color:#aaa}
.tabs{display:flex;gap:4px;padding:7px;border-bottom:1px solid var(--line);overflow:auto;background:#1b1812}
.tab{white-space:nowrap}
.tab.active{border-color:var(--gold);color:#ffe08c;background:#4b3b22}
.content{padding:12px;min-height:630px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.card{border:1px solid var(--line);background:#201b14;padding:9px}
.card h3{margin:0 0 6px;color:#e7c271;font-size:15px}
.muted{color:var(--muted);font-size:12px}
.stat-table{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.stat{background:#17140f;border:1px solid #403624;padding:8px;text-align:center}
.stat b{display:block;font-size:17px;color:#fff}
.item{display:grid;grid-template-columns:1fr auto;gap:8px;border-bottom:1px solid #3b3224;padding:8px 0}
.item:last-child{border-bottom:0}
.item-name{font-weight:bold}
.r0{color:#b8b1a5}.r1{color:#72c57d}.r2{color:#67a9e2}.r3{color:#c28adf}.r4{color:#e2b752}.r5{color:#ff5151;font-weight:bold;text-shadow:0 0 7px #b30000}.mutant-x{color:#ff4242;font-weight:800;text-shadow:0 0 8px #d00000}.mutant-card{box-shadow:inset 3px 0 0 #c33131}.law-card{border:1px solid rgba(172,126,255,.45);box-shadow:inset 3px 0 0 #8b5cf6}.law-name{color:#c5a8ff;font-weight:800}.rebirth-power{font-size:1.08em;font-weight:800}.grade-F{color:#8c8982}.grade-E{color:#9a927f}.grade-D{color:#72a675}.grade-C{color:#58a5c7}.grade-B{color:#557fe0}.grade-A{color:#9b68d1;font-weight:bold}.grade-S{color:#dd9745;font-weight:bold}.grade-SS{color:#e05c7a;font-weight:bold}.grade-SSS{color:#f1cf52;font-weight:bold;text-shadow:0 0 7px #d28732}
.compare{font-size:11px;color:#9fc69f}
.skill-row{display:grid;grid-template-columns:1fr auto;gap:8px;padding:8px;border:1px solid #403624;background:#17140f;margin-bottom:6px}
.skill-row.on{border-color:#92753e;background:#2b2417}
.map-card{border:1px solid #493d2a;background:#1b1812;padding:9px;margin-bottom:7px}
.map-card.selected{border-color:var(--gold)}
.map-head{display:flex;justify-content:space-between;gap:8px}
.risk-safe{color:var(--good)}.risk-even{color:#e9c96d}.risk-hard{color:var(--bad)}
.pet-row{display:grid;grid-template-columns:52px 1fr auto;gap:9px;align-items:center;border-bottom:1px solid #3b3224;padding:8px 0}
.pet-icon{font-size:32px;text-align:center}
.controls{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}

.notice{border:1px solid #655330;background:#302718;padding:9px;margin-bottom:10px;color:#e7d6b4}
details.help{border:1px solid #4b402e;background:#1b1812;margin:0 0 10px}
details.help>summary{cursor:pointer;padding:8px 10px;color:#d7ad55;font-weight:700;list-style:none;user-select:none}
details.help>summary::-webkit-details-marker{display:none}
details.help>summary::after{content:'＋';float:right;color:#a99a80}
details.help[open]>summary::after{content:'－'}
.help-body{border-top:1px solid #3b3224;padding:9px 10px;color:#a99a80;font-size:12px;line-height:1.55}
details.mini{margin-top:5px}
details.mini>summary{cursor:pointer;color:#c9aa68;font-size:12px;list-style:none;user-select:none;display:inline-block}
details.mini>summary::-webkit-details-marker{display:none}
details.mini>summary::after{content:' ▾';color:#7f725e}
details.mini[open]>summary::after{content:' ▴'}
details.mini .help-body{border:0;padding:6px 0 0;font-size:12px}
.compact-meta{color:var(--muted);font-size:12px;margin-top:3px}
.compact-tags{display:flex;flex-wrap:wrap;gap:4px;margin-top:5px}
.compact-tag{border:1px solid #4b402e;background:#17140f;padding:2px 5px;font-size:10px;color:#c8b99f}

.start{max-width:900px;margin:35px auto;border:1px solid var(--line);background:#1b1812;padding:18px}
.choice-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.choice{border:1px solid #51442f;background:#211c14;padding:12px;cursor:pointer}
.choice.selected{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold) inset}
.choice h3{margin:0 0 5px;color:#e8c36b}
.footer{color:#766d5d;font-size:11px;text-align:center;padding:10px}

.mobile-only,.mobile-nav,.mobile-sheet,.mobile-backdrop{display:none}
@media(max-width:850px){
 html{scroll-behavior:smooth}
 body{font-size:15px;line-height:1.5;-webkit-text-size-adjust:100%;padding-bottom:calc(74px + env(safe-area-inset-bottom))}
 .shell{padding:6px 6px calc(18px + env(safe-area-inset-bottom))}
 .topbar{grid-template-columns:1fr;padding:10px;gap:8px;position:sticky;top:0;z-index:20}
 h1{font-size:18px;line-height:1.2}
 .subtitle{font-size:11px}
 .resources{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px;justify-content:stretch}
 .resources span{background:#17140f;border:1px solid #403624;padding:5px 6px;text-align:center;min-width:0;font-size:11px;border-radius:3px}
 .resources b{display:block;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
 .xp-chip{min-width:0}.xp-mini{display:none}
 .layout{grid-template-columns:1fr;gap:7px;margin-top:7px}
 .panel{box-shadow:none}
 .panel-title{padding:8px}
 .battle{padding:7px}
 .combatant{padding:7px;margin-bottom:6px}
 .big-name{font-size:14px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
 .badge{font-size:10px;white-space:nowrap}
 .stats-mini{gap:3px}.stats-mini div{padding:4px;font-size:10px}
 .log{height:118px;font-size:11px;padding:6px}
 .tabs{display:none}
 .content{min-height:auto;padding:8px}
 .grid2,.grid3,.choice-grid{grid-template-columns:1fr}
 .stat-table{grid-template-columns:repeat(2,1fr)}
 .stat{padding:7px}.stat b{font-size:16px}
 .card{padding:8px}
 .notice{padding:8px;font-size:13px}
 details.help>summary{min-height:40px;display:flex;align-items:center;justify-content:space-between;padding:8px}
 .help-body{padding:8px;font-size:12px}
 details.mini>summary{padding:3px 0}
 .item,.skill-row,.pet-row{grid-template-columns:1fr;gap:6px;align-items:stretch}
 .pet-row{padding:10px 0}
 .pet-icon{font-size:28px;text-align:left}
 .map-head{flex-direction:column;align-items:flex-start}
 .controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;width:100%}
 .controls button,.card>button,.item>button,.skill-row button,.map-card button{
   min-height:44px;padding:9px 10px;touch-action:manipulation
 }
 button,select,input{font-size:16px}
 select{min-height:44px;max-width:100%;padding:6px}
 .choice{padding:12px;min-height:72px}
 .start{margin:8px auto;padding:12px}
 .footer{padding:8px 8px 12px;font-size:10px}
 .mobile-only{display:block}
 .mobile-nav{
   display:grid;grid-template-columns:repeat(6,1fr);position:fixed;left:0;right:0;bottom:0;z-index:80;
   padding:5px 5px calc(5px + env(safe-area-inset-bottom));gap:3px;
   background:rgba(20,17,13,.97);border-top:1px solid var(--line);backdrop-filter:blur(12px)
 }
 .mobile-nav button{
   border:0;background:transparent;min-width:0;min-height:54px;padding:4px 2px;color:var(--muted);
   display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;font-size:10px
 }
 .mobile-nav button b{display:block;font-size:18px;line-height:1.1;font-weight:normal}
 .mobile-nav button.active{color:#ffe08c;background:#342918;border-radius:6px}
 .mobile-backdrop{display:block;position:fixed;inset:0;z-index:88;background:#0009}
 .mobile-sheet{
   display:block;position:fixed;z-index:90;left:8px;right:8px;bottom:calc(66px + env(safe-area-inset-bottom));
   background:#211d16;border:1px solid var(--line);box-shadow:0 12px 40px #000c;padding:10px;border-radius:10px
 }
 .mobile-sheet h3{margin:0 0 8px;color:var(--gold)}
 .mobile-sheet-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:7px}
 .mobile-sheet button{min-height:46px}
 .mobile-sheet .danger{border-color:#8b3b34;color:#ff9990}
 .main-panel{scroll-margin-top:112px}
 .battle-panel-wrap{scroll-margin-top:112px}
}
@media(max-width:390px){
 .resources{grid-template-columns:repeat(2,minmax(0,1fr))}
 .mobile-nav button{font-size:9px}
 .mobile-nav button b{font-size:17px}
 .controls{grid-template-columns:1fr}
}

</style>
</head>
<body>
<div id="app"></div>
<script>
'use strict';
const VERSION='0.30.0';
const SAVE_KEY='bwe-core-alpha-030';
const ALPHA029_SAVE_KEY='bwe-core-alpha-029';
const ALPHA028_SAVE_KEY='bwe-core-alpha-028';
const ALPHA027_SAVE_KEY='bwe-core-alpha-027';
const ALPHA026_SAVE_KEY='bwe-core-alpha-026';
const ALPHA025_SAVE_KEY='bwe-core-alpha-025';
const ALPHA024_SAVE_KEY='bwe-core-alpha-024';
const ALPHA023_SAVE_KEY='bwe-core-alpha-023';
const ALPHA022_SAVE_KEY='bwe-core-alpha-022';
const ALPHA021_SAVE_KEY='bwe-core-alpha-021';
const ALPHA020_SAVE_KEY='bwe-core-alpha-020';
const ALPHA019_SAVE_KEY='bwe-core-alpha-019';
const ALPHA018_SAVE_KEY='bwe-core-alpha-018';
const ALPHA017_SAVE_KEY='bwe-core-alpha-017';
const ALPHA016_SAVE_KEY='bwe-core-alpha-016';
const ALPHA015_SAVE_KEY='bwe-core-alpha-015';
const ALPHA014_SAVE_KEY='bwe-core-alpha-014';
const ALPHA013_SAVE_KEY='bwe-core-alpha-013';
const ALPHA012_SAVE_KEY='bwe-core-alpha-012';
const ALPHA011_SAVE_KEY='bwe-core-alpha-011';
const ALPHA010_SAVE_KEY='bwe-core-alpha-010';
const ALPHA09_SAVE_KEY='bwe-core-alpha-09';
const PREVIOUS_SAVE_KEY='bwe-core-alpha-08';
const LEGACY_SAVE_KEY='bwe-core-alpha-07';
const OLDER_SAVE_KEY='bwe-core-alpha-06';
const OLDEST_SAVE_KEY='bwe-core-alpha-05';
const ANCIENT_SAVE_KEY='bwe-core-alpha-04';
const PRIMITIVE_SAVE_KEY='bwe-core-alpha-03';

const RACES={
 human:{name:'人类',icon:'🧑',desc:'均衡种族。所有属性成长系数×1.00；经验获得+8%。',growth:{str:1.0,int:1.0,dex:1.0,will:1.0,luck:1.0},bonus:{xp:1.08},bonusText:'经验获取×1.08；五项成长系数均为1.00。'},
 elf:{name:'精灵',icon:'🧝',desc:'敏捷与智力倾向。力量×0.72、智力×1.28、敏捷×1.24、意志×1.02、幸运×1.18。',growth:{str:.72,int:1.28,dex:1.24,will:1.02,luck:1.18},bonus:{},bonusText:'无额外战斗倍率；优势来自成长比例：智力、敏捷、幸运更高。'},
 orc:{name:'兽人',icon:'👹',desc:'力量与生存倾向。力量×1.38、智力×0.58、敏捷×0.82、意志×1.12、幸运×0.72；最大生命+12%。',growth:{str:1.38,int:.58,dex:.82,will:1.12,luck:.72},bonus:{hp:1.12},bonusText:'最大生命×1.12；力量与意志成长更高。'},
 undead:{name:'亡灵',icon:'💀',desc:'意志与吸血倾向。力量×0.94、智力×0.90、敏捷×0.78、意志×1.36、幸运×0.82；生命汲取效果+20%。',growth:{str:.94,int:.9,dex:.78,will:1.36,luck:.82},bonus:{drain:1.2},bonusText:'生命汲取回复效果×1.20；意志成长最高。'}
};
const STYLES={
 melee:{name:'近战',icon:'⚔️',desc:'力量主成长。力量×1.28、智力×0.55、敏捷×0.86、意志×1.00、幸运×0.82。',weapon:'剑',growth:{str:1.28,int:.55,dex:.86,will:1.0,luck:.82},formula:'近战攻击 = 力量×2.35 + 敏捷×0.30 + 等级×2.00 + 装备攻击'},
 ranged:{name:'远程',icon:'🏹',desc:'敏捷主成长。力量×0.78、智力×0.65、敏捷×1.38、意志×0.95、幸运×1.08。',weapon:'弓',growth:{str:.78,int:.65,dex:1.38,will:.95,luck:1.08},formula:'远程攻击 = 敏捷×2.25 + 力量×0.35 + 等级×2.00 + 装备攻击'},
 magic:{name:'魔法',icon:'🔮',desc:'智力主成长。力量×0.50、智力×1.46、敏捷×0.82、意志×1.12、幸运×0.95。',weapon:'法杖',growth:{str:.5,int:1.46,dex:.82,will:1.12,luck:.95},formula:'魔法攻击 = 智力×2.25 + 意志×0.25 + 等级×1.90 + 装备攻击'}
};

const WEAPON_TYPES={
 sword:{name:'长剑',styles:['melee'],desc:'暴击率+6%，稳定近战。',mods:{crit:6}},
 axe:{name:'战斧',styles:['melee'],desc:'攻击×1.16，速度-2。',mods:{atkMult:1.16,speed:-2}},
 bow:{name:'长弓',styles:['ranged'],desc:'远程伤害×1.13，速度+2。',mods:{rangedMult:1.13,speed:2}},
 crossbow:{name:'重弩',styles:['ranged'],desc:'远程伤害×1.23，速度-2。',mods:{rangedMult:1.23,speed:-2}},
 staff:{name:'法杖',styles:['magic'],desc:'魔法伤害×1.15，最大法力+20。',mods:{magicMult:1.15,mp:20}},
 tome:{name:'魔典',styles:['magic'],desc:'魔法伤害×1.06，技能触发率+7%。',mods:{magicMult:1.06,skillChance:.07}}
};

const MAPS=[
 {id:'meadow',name:'新月草原',cp:117,mod:0.0,gearTier:1,petTier:1,threatCap:3,levels:[1,7],monsters:['幼角兔','灰尾狸','草原史莱姆'],boss:'月背巨狼',pet:'灰尾幼狼'},
 {id:'hill',name:'裂风丘陵',cp:313,mod:0.25,gearTier:2,petTier:2,threatCap:4,levels:[8,17],monsters:['岩皮蜥','狂风鹰','丘陵鬣狗'],boss:'裂风狮王',pet:'裂风幼狮'},
 {id:'forest',name:'魂木森林',cp:771,mod:0.6,gearTier:3,petTier:3,threatCap:5,levels:[18,30],monsters:['毒牙蛛','苔甲兽','幽光鹿'],boss:'千年树灵',pet:'树灵幼芽'},
 {id:'shore',name:'霜蚀海岸',cp:1695,mod:1.0,gearTier:4,petTier:4,threatCap:6,levels:[31,47],monsters:['冰壳蟹','冻原狼人','霜鳍鱼人'],boss:'极寒海兽',pet:'霜鳍幼兽'},
 {id:'ruins',name:'失落王城',cp:3795,mod:1.55,gearTier:5,petTier:5,threatCap:8,levels:[48,68],monsters:['王城亡魂','黑甲守卫','诅咒法师'],boss:'不灭王魂',pet:'王魂侍从'},
 {id:'abyss',name:'星渊尽头',cp:26000,mod:2.2,gearTier:6,petTier:6,threatCap:Infinity,levels:[69,100],monsters:['虚空猎犬','星蚀魔像','深渊观测者'],boss:'终焉星龙',pet:'星核幼龙'}
];
const RARITIES=[
 {name:'普通',cls:'r0',score:1.00,aff:0,sell:1},
 {name:'优秀',cls:'r1',score:1.22,aff:1,sell:2},
 {name:'稀有',cls:'r2',score:1.52,aff:2,sell:4},
 {name:'史诗',cls:'r3',score:1.90,aff:3,sell:8},
 {name:'传说',cls:'r4',score:2.35,aff:4,sell:16},
 {name:'神话',cls:'r5',score:3.00,aff:5,sell:38}
];
const QUALITY_SCORE_MULT=[1.00,1.24,1.55,1.95,2.46,3.10];
const QUALITY_MIN=[1.00,1.28,1.64,2.10,2.72,3.55];
const QUALITY_MAX=[1.10,1.44,1.95,2.66,3.65,5.05];
const SLOTS=['weapon','head','armor','boots','ring','amulet'];
